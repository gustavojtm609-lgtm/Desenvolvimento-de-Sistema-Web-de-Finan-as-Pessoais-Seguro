PORT=3000
APP_ORIGIN=http://localhost:3000
DEV_ORIGIN=http://localhost:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=expenses_control
MYSQL_USER=expenses
MYSQL_PASSWORD=GERAR_SENHA_MYSQL
MYSQL_ROOT_PASSWORD=GERAR_SENHA_ROOT
# Use true somente com HTTPS. Para Docker local em HTTP, mantenha false.
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8
SESSION_IDLE_MINUTES=30
# Ative apenas atrás de um proxy reverso confiável e único.
TRUST_PROXY=0
# Opcional para npm run db:seed. Use senha exclusiva com letra, número e >=10 caracteres.
DEMO_PASSWORD=
# Deixe vazio para usar a API na mesma origem.
VITE_API_URL=
